{
  "type": "APL",
  "version": "2023.3",
  "license": "Winston control center for Echo Show 11 (hub landscape)",
  "theme": "dark",
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.7.0"
    }
  ],
  "resources": [
    {
      "colors": {
        "colorBackground": "#0E1420",
        "colorPanel": "#182236",
        "colorAccent": "#D9A441",
        "colorAlert": "#E5484D",
        "colorWarn": "#E8A33D",
        "colorDone": "#4CAF7D",
        "colorTextPrimary": "#F5F1E8",
        "colorTextSecondary": "#8FA0BC"
      }
    }
  ],
  "layouts": {
    "PanelTitle": {
      "parameters": [
        { "name": "title", "type": "string" },
        { "name": "titleColor", "type": "color", "default": "@colorAccent" }
      ],
      "items": [
        {
          "type": "Text",
          "text": "${title}",
          "fontSize": "22dp",
          "fontWeight": "700",
          "letterSpacing": "2dp",
          "color": "${titleColor}",
          "paddingBottom": "@spacingXSmall"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "direction": "column",
        "items": [
          {
            "type": "Frame",
            "position": "absolute",
            "width": "100vw",
            "height": "100vh",
            "backgroundColor": "@colorBackground"
          },
          {
            "type": "Container",
            "width": "100vw",
            "paddingLeft": "@spacingLarge",
            "paddingRight": "@spacingLarge",
            "paddingTop": "@spacingMedium",
            "direction": "row",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "WINSTON",
                "fontSize": "30dp",
                "fontWeight": "700",
                "letterSpacing": "4dp",
                "color": "@colorAccent"
              },
              {
                "type": "Text",
                "text": "Control Center",
                "fontSize": "22dp",
                "color": "@colorTextSecondary",
                "paddingLeft": "@spacingMedium",
                "grow": 1
              },
              {
                "type": "Text",
                "text": "${payload.winston.dateLine}",
                "fontSize": "22dp",
                "color": "@colorTextSecondary"
              }
            ]
          },
          {
            "type": "Text",
            "when": "${payload.winston.focus != ''}",
            "text": "Focus: ${payload.winston.focus}",
            "fontSize": "24dp",
            "color": "@colorTextPrimary",
            "paddingLeft": "@spacingLarge",
            "paddingRight": "@spacingLarge",
            "paddingTop": "@spacingXSmall"
          },
          {
            "type": "Container",
            "grow": 1,
            "shrink": 1,
            "width": "100vw",
            "direction": "row",
            "paddingLeft": "@spacingLarge",
            "paddingRight": "@spacingLarge",
            "paddingTop": "@spacingSmall",
            "paddingBottom": "@spacingSmall",
            "items": [
              {
                "type": "Sequence",
                "width": "56%",
                "height": "100%",
                "data": "${payload.winston.buckets}",
                "items": [
                  {
                    "type": "Frame",
                    "backgroundColor": "@colorPanel",
                    "borderRadius": "12dp",
                    "items": [
                      {
                        "type": "Container",
                        "paddingLeft": "@spacingMedium",
                        "paddingRight": "@spacingMedium",
                        "paddingTop": "@spacingSmall",
                        "paddingBottom": "@spacingSmall",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${data.name}",
                            "fontSize": "22dp",
                            "fontWeight": "700",
                            "letterSpacing": "1dp",
                            "color": "@colorAccent",
                            "paddingBottom": "@spacingXSmall"
                          },
                          {
                            "type": "Container",
                            "data": "${data.items}",
                            "items": [
                              {
                                "type": "Container",
                                "direction": "row",
                                "paddingBottom": "2dp",
                                "items": [
                                  {
                                    "type": "Text",
                                    "text": "${data.done ? '✓' : '○'}",
                                    "fontSize": "22dp",
                                    "color": "${data.done ? '@colorDone' : '@colorTextSecondary'}",
                                    "paddingRight": "@spacingSmall"
                                  },
                                  {
                                    "type": "Text",
                                    "text": "${data.text}",
                                    "fontSize": "22dp",
                                    "color": "${data.done ? '@colorTextSecondary' : '@colorTextPrimary'}",
                                    "shrink": 1
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "height": "@spacingSmall"
                  }
                ]
              },
              {
                "type": "ScrollView",
                "width": "44%",
                "height": "100%",
                "paddingLeft": "@spacingMedium",
                "items": [
                  {
                    "type": "Container",
                    "items": [
                      {
                        "type": "Frame",
                        "backgroundColor": "@colorPanel",
                        "borderRadius": "12dp",
                        "items": [
                          {
                            "type": "Container",
                            "paddingLeft": "@spacingMedium",
                            "paddingRight": "@spacingMedium",
                            "paddingTop": "@spacingSmall",
                            "paddingBottom": "@spacingSmall",
                            "items": [
                              {
                                "type": "PanelTitle",
                                "title": "OVERDUE / DUE TODAY",
                                "titleColor": "@colorAlert"
                              },
                              {
                                "type": "Text",
                                "when": "${payload.winston.overdue.length == 0}",
                                "text": "Nothing overdue.",
                                "fontSize": "22dp",
                                "color": "@colorTextSecondary"
                              },
                              {
                                "type": "Container",
                                "data": "${payload.winston.overdue}",
                                "items": [
                                  {
                                    "type": "Text",
                                    "text": "• ${data.text}  (${data.due})",
                                    "fontSize": "22dp",
                                    "color": "@colorTextPrimary",
                                    "paddingBottom": "2dp"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "height": "@spacingSmall"
                      },
                      {
                        "type": "Frame",
                        "backgroundColor": "@colorPanel",
                        "borderRadius": "12dp",
                        "items": [
                          {
                            "type": "Container",
                            "paddingLeft": "@spacingMedium",
                            "paddingRight": "@spacingMedium",
                            "paddingTop": "@spacingSmall",
                            "paddingBottom": "@spacingSmall",
                            "items": [
                              {
                                "type": "PanelTitle",
                                "title": "PIPELINE — NEEDS ATTENTION",
                                "titleColor": "@colorWarn"
                              },
                              {
                                "type": "Text",
                                "when": "${payload.winston.pipeline.length == 0}",
                                "text": "Pipeline is clean.",
                                "fontSize": "22dp",
                                "color": "@colorTextSecondary"
                              },
                              {
                                "type": "Container",
                                "data": "${payload.winston.pipeline}",
                                "items": [
                                  {
                                    "type": "Container",
                                    "paddingBottom": "@spacingXSmall",
                                    "items": [
                                      {
                                        "type": "Text",
                                        "text": "${data.name} — ${data.status}",
                                        "fontSize": "22dp",
                                        "color": "@colorTextPrimary"
                                      },
                                      {
                                        "type": "Text",
                                        "text": "→ ${data.action}",
                                        "fontSize": "20dp",
                                        "color": "@colorTextSecondary"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "height": "@spacingSmall"
                      },
                      {
                        "type": "Frame",
                        "backgroundColor": "@colorPanel",
                        "borderRadius": "12dp",
                        "items": [
                          {
                            "type": "Container",
                            "paddingLeft": "@spacingMedium",
                            "paddingRight": "@spacingMedium",
                            "paddingTop": "@spacingSmall",
                            "paddingBottom": "@spacingSmall",
                            "items": [
                              {
                                "type": "PanelTitle",
                                "title": "CADENCE"
                              },
                              {
                                "type": "Text",
                                "text": "Touches this week: ${payload.winston.cadence.touchesThisWeek}",
                                "fontSize": "22dp",
                                "color": "@colorTextPrimary"
                              },
                              {
                                "type": "Text",
                                "text": "LinkedIn: ${payload.winston.cadence.lastLinkedIn}   Email/phone: ${payload.winston.cadence.lastEmailPhone}",
                                "fontSize": "20dp",
                                "color": "@colorTextSecondary"
                              },
                              {
                                "type": "Text",
                                "text": "Pipeline review: ${payload.winston.cadence.lastPipelineReview}",
                                "fontSize": "20dp",
                                "color": "@colorTextSecondary"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "Text",
            "text": "${payload.winston.footerLine}",
            "fontSize": "18dp",
            "color": "@colorTextSecondary",
            "textAlign": "center",
            "paddingBottom": "@spacingSmall"
          }
        ]
      }
    ]
  }
}
