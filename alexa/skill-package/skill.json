{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Winston Assistant",
          "summary": "Winston, Howard's executive assistant, on the Echo Show.",
          "description": "Talk to Winston — a direct, no-fluff executive assistant powered by Claude. Ask about your day, your pipeline, your priorities, or anything else. Optimized for the Echo Show 11 display.",
          "examplePhrases": [
            "Alexa, open winston assistant",
            "ask what should I focus on today",
            "tell me how to structure my morning"
          ],
          "keywords": ["assistant", "productivity", "executive", "claude"]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": ["US"],
      "testingInstructions": "Set the ANTHROPIC_API_KEY environment variable on the Lambda before testing.",
      "category": "PRODUCTIVITY"
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "REPLACE_WITH_LAMBDA_ARN"
        },
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1280,
                "maxWidth": 2560,
                "minHeight": 600,
                "maxHeight": 1600
              }
            ]
          }
        ]
      }
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "",
          "termsOfUseUrl": ""
        }
      }
    }
  }
}
